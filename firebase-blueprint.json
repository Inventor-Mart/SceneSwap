{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User account profile and VIP Director Pass subscription state",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Unique Firebase Authentication UID"
        },
        "email": {
          "type": "string",
          "description": "User email address"
        },
        "display_name": {
          "type": "string",
          "description": "Party director or player display name"
        },
        "is_director_pro": {
          "type": "boolean",
          "description": "Whether user has unlocked SceneSwap VIP Director Pass"
        },
        "created_at": {
          "type": "string",
          "description": "ISO timestamp of account creation"
        },
        "updated_at": {
          "type": "string",
          "description": "ISO timestamp of latest update"
        }
      },
      "required": ["uid", "email"]
    },
    "SceneSwapSession": {
      "title": "SceneSwapSession",
      "description": "Active SceneSwap party session, cast roster, current act, and custom photo settings",
      "type": "object",
      "properties": {
        "user_id": {
          "type": "string",
          "description": "Owner Firebase UID"
        },
        "title": {
          "type": "string",
          "description": "Current screenplay title"
        },
        "genre": {
          "type": "string",
          "description": "Selected screenplay genre"
        },
        "premise": {
          "type": "string",
          "description": "Optional custom premise or inside joke"
        },
        "chapter_number": {
          "type": "number",
          "description": "Current act progression (1 to 3)"
        },
        "is_finale": {
          "type": "boolean",
          "description": "Whether current act is the grand finale"
        },
        "created_at": {
          "type": "string",
          "description": "Creation timestamp"
        },
        "updated_at": {
          "type": "string",
          "description": "Latest update timestamp"
        }
      },
      "required": ["user_id"]
    },
    "SceneSwapSavedScript": {
      "title": "SceneSwapSavedScript",
      "description": "Saved screenplay act or completed movie production",
      "type": "object",
      "properties": {
        "user_id": {
          "type": "string",
          "description": "Owner Firebase UID"
        },
        "script_id": {
          "type": "string",
          "description": "Unique script identifier"
        },
        "title": {
          "type": "string",
          "description": "Screenplay title"
        },
        "genre": {
          "type": "string",
          "description": "Screenplay genre"
        },
        "total_acts": {
          "type": "number",
          "description": "Total acts completed"
        },
        "created_at": {
          "type": "string",
          "description": "Creation timestamp"
        }
      },
      "required": ["user_id", "title"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Top-level user profile keyed by Firebase Auth UID"
    },
    "/users/{userId}/sceneswap/session": {
      "schema": "SceneSwapSession",
      "description": "Active SceneSwap party session and cast roster"
    },
    "/users/{userId}/scripts/{scriptId}": {
      "schema": "SceneSwapSavedScript",
      "description": "Saved screenplay productions archived by the user"
    }
  }
}
