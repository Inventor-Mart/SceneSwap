rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Connectivity test probe
    match /test/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // User profile: only the authenticated user can access their own document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Subcollection for SceneSwap screenplay projects, branch decisions, and director cuts
      match /sceneswap/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Public community showcase of director cuts (read-only for all, write for owner)
    match /showcase/{projectId} {
      allow read: if true;
      allow write: if request.auth != null && request.resource.data.user_id == request.auth.uid;
    }
  }
}
