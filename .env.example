# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# RESEND_API_KEY: Transactional email API key from Resend (https://resend.com/api-keys)
RESEND_API_KEY="re_123456789"

# SUPPORT_EMAIL: Inbound destination mailbox for user support inquiries
SUPPORT_EMAIL="martorefe@gmail.com"

# RESEND_FROM_EMAIL: Sender address.
# Leave as "SceneSwap Support <onboarding@resend.dev>" for instant out-of-the-box delivery
# to your registered Resend account email (martorefe@gmail.com) without needing DNS domain verification.
# If you verify a custom domain on https://resend.com/domains (e.g. mail.yourdomain.com), set to "SceneSwap <support@yourdomain.com>".
# Note: Do not set to a personal @gmail.com address here as Resend requires verified domain DNS records for custom senders.
RESEND_FROM_EMAIL="SceneSwap Support <onboarding@resend.dev>"

# PAYSTACK_SECRET_KEY: Secret key from Paystack Dashboard (Settings -> API Keys & Webhooks)
# Test keys start with "sk_test_...", Live keys start with "sk_live_..."
# When left unset, the app runs in developer simulation mode so you can test the checkout UI seamlessly.
PAYSTACK_SECRET_KEY="sk_test_your_paystack_secret_key"
VITE_PAYSTACK_PUBLIC_KEY="pk_test_your_paystack_public_key"

